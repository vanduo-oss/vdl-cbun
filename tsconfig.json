{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "types": []
  },
  "include": ["src/**/*", "tests/**/*", "component-versions.json"]
}
